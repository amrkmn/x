{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "endOfLine": "lf",
    "ignorePatterns": ["dist/**", "static/**", "tools/oxlint/anti-slop/**"],
    "printWidth": 100,
    "semi": true,
    "singleQuote": true,
    "svelte": true,
    "tabWidth": 4,
    "trailingComma": "none",
    "useTabs": false,
    "sortImports": true
}
