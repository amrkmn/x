{
    "name": "x",
    "version": "0.0.1",
    "private": true,
    "description": "Mihon & Aniyomi Extensions",
    "keywords": [
        "anime",
        "aniyomi",
        "extensions",
        "manga",
        "mihon"
    ],
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "pnpm run data:generate && astro build",
        "preview": "astro preview",
        "check": "astro check",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "update": "tsx --env-file-if-exists=.env scripts/task.ts full",
        "update:check": "tsx --env-file-if-exists=.env scripts/task.ts check",
        "update:static": "tsx --env-file-if-exists=.env scripts/task.ts static",
        "data:generate": "tsx --env-file-if-exists=.env scripts/task.ts data",
        "search:update": "tsx --env-file-if-exists=.env scripts/task.ts search",
        "cache:restore": "tsx --env-file-if-exists=.env scripts/task.ts cache restore",
        "cache:save": "tsx --env-file-if-exists=.env scripts/task.ts cache save",
        "prepare:dist": "tsx --env-file-if-exists=.env scripts/task.ts prepare-dist",
        "sync": "pnpm run update:static",
        "test": "vitest run",
        "prepare": "tsx scripts/setup-hooks.ts",
        "setup-hooks": "tsx scripts/setup-hooks.ts"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@astrojs/svelte": "^9.0.1",
        "@bradenmacdonald/s3-lite-client": "^1.0.0",
        "@oxlint/plugins": "^1.80.0",
        "@types/node": "^26.4.0",
        "astro": "7.2.9",
        "dax": "^0.49.0",
        "meilisearch": "^0.60.0",
        "minisearch": "^7.2.0",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0",
        "svelte": "^5.57.0",
        "tar": "^7.5.22",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11",
        "wrangler": "^4.127.1"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24"
        }
    },
    "engines": {
        "node": ">=24.0.0 <25"
    },
    "packageManager": "pnpm@12.1.0"
}
