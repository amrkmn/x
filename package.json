{
    "name": "x",
    "version": "0.0.1",
    "private": true,
    "description": "Mihon & Aniyomi Extensions",
    "keywords": [
        "anime",
        "aniyomi",
        "extensions",
        "manga",
        "mihon"
    ],
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "nub run data:generate && astro build",
        "preview": "astro preview",
        "check": "astro check",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "update:check": "nub scripts/task.ts check",
        "update:local": "nub scripts/task.ts local",
        "publish:releases": "nub scripts/task.ts publish",
        "cleanup:releases": "nub scripts/task.ts cleanup",
        "update:static": "nub scripts/task.ts static",
        "data:generate": "nub scripts/task.ts data",
        "search:update": "nub scripts/task.ts search",
        "prepare:dist": "nub scripts/task.ts prepare-dist",
        "build:all": "nub scripts/task.ts build-all",
        "deploy:all": "nub scripts/task.ts deploy-all",
        "test": "vitest run",
        "prepare": "nub scripts/setup-hooks.ts",
        "setup-hooks": "nub scripts/setup-hooks.ts"
    },
    "dependencies": {
        "dax": "^0.50.1",
        "meilisearch": "^0.62.0",
        "minisearch": "^7.2.0",
        "protobufjs": "^8.8.1"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.12",
        "@astrojs/svelte": "^9.1.2",
        "@oxlint/plugins": "^1.90.0",
        "@types/node": "^26.6.6",
        "astro": "^7.4.4",
        "netlify-cli": "^27.14.2",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "svelte": "^5.57.3",
        "typescript": "^6.0.3",
        "vitest": "^5.0.5",
        "wrangler": "^4.156.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "nub",
            "version": "^0.10.0",
            "onFail": "ignore"
        },
        "runtime": {
            "name": "node",
            "version": ">=24.0.0"
        }
    },
    "allowScripts": {
        "esbuild": true,
        "workerd": true
    }
}
