{
    "name": "x",
    "version": "0.0.1",
    "private": true,
    "description": "Mihon & Aniyomi Extensions",
    "keywords": [
        "anime",
        "aniyomi",
        "extensions",
        "manga",
        "mihon"
    ],
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "pnpm run data:generate && astro build",
        "preview": "astro preview",
        "check": "astro check",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "update:check": "tsx --env-file-if-exists=.env scripts/task.ts check",
        "update:local": "tsx --env-file-if-exists=.env scripts/update-local.ts",
        "publish:releases": "tsx scripts/publish.ts",
        "update:static": "tsx --env-file-if-exists=.env scripts/task.ts static",
        "data:generate": "tsx --env-file-if-exists=.env scripts/task.ts data",
        "search:update": "tsx --env-file-if-exists=.env scripts/task.ts search",
        "prepare:dist": "tsx --env-file-if-exists=.env scripts/task.ts prepare-dist",
        "test": "vitest run",
        "prepare": "tsx scripts/setup-hooks.ts",
        "setup-hooks": "tsx scripts/setup-hooks.ts"
    },
    "dependencies": {
        "protobufjs": "^8.8.1"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@astrojs/svelte": "^9.0.1",
        "@oxlint/plugins": "^1.86.0",
        "@types/node": "^26.6.3",
        "astro": "^7.3.5",
        "dax": "^0.50.0",
        "meilisearch": "^0.62.0",
        "minisearch": "^7.2.0",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "svelte": "^5.57.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vitest": "^5.0.2",
        "wrangler": "^4.143.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.0.0"
        }
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@12.5.1"
}
